<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="login_layout" inherit_id="web.login_layout" name="Login Layout Inherit">
        <xpath expr="//div[hasclass('container')]" position="attributes">
            <attribute name="class">body_login</attribute>
        </xpath>

        <xpath expr="//div[contains(@t-attf-class, 'o_database_list')]" position="before">
            <div id="background-wrapper" t-attf-style="background-image: url('{{ background_src or '' }}');"/>
        </xpath>

        <xpath expr="//div[contains(@t-attf-class, 'o_database_list')]" position="attributes">
            <attribute name="class">col-11 col-sm-6 col-md-4 col-lg-3 o_database_list</attribute>
            <attribute name="style"/>
        </xpath>

        <xpath expr="//div[hasclass('card-body')]//img[1]" position="attributes">
            <attribute name="class">company_logo</attribute>
        </xpath>
    </template>

    <template id="login" inherit_id="web.login" name="Login Inherit">
        <xpath expr="//label[@for='db']" position="attributes">
            <attribute name="class" add="d-none" separator=" "/>
        </xpath>
        <xpath expr="//label[@for='login']" position="attributes">
            <attribute name="class" add="d-none" separator=" "/>
        </xpath>
        <xpath expr="//label[@for='password']" position="attributes">
            <attribute name="class" add="d-none" separator=" "/>
        </xpath>

        <xpath expr="//input[@name='login']" position="attributes">
            <attribute name="placeholder">Email ...</attribute>
            <attribute name="autocomplete">username</attribute>
        </xpath>

        <xpath expr="//input[@name='password']" position="attributes">
            <attribute name="placeholder">Password ...</attribute>
        </xpath>

        <xpath expr="//a[@href='/web/database/selector']" position="replace">
            <a role="button" href="/web/database/selector" class="btn btn-secondary">
                <i class="oi" data-icon="database" role="img" aria-label="Database" title="Database"/>
            </a>
        </xpath>
    </template>

</odoo>
