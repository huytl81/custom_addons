<?xml version="1.0" encoding="UTF-8" ?>
<!-- Save and Discard Button-->
<templates xml:space="preserve">
    <t
        t-name="web_save_discard_button.FormStatusIndicator"
        t-inherit="web.FormStatusIndicator"
        t-inherit-mode="extension"
    >
        <xpath expr="//button[hasclass('o_form_button_save')]" position="attributes">
            <attribute name="class">o_form_button_save btn btn-primary d-inline-flex align-items-center px-2 py-1</attribute>
        </xpath>
        <xpath expr="//button[hasclass('o_form_button_save')]/i" position="after">
            <span class="ms-1">Save</span>
        </xpath>

        <xpath expr="//button[hasclass('o_form_button_cancel')]" position="attributes">
            <attribute name="class">o_form_button_cancel btn btn-secondary d-inline-flex align-items-center px-2 py-1</attribute>
        </xpath>
        <xpath expr="//button[hasclass('o_form_button_cancel')]/i" position="after">
            <span class="ms-1">Discard</span>
        </xpath>
    </t>
</templates>
